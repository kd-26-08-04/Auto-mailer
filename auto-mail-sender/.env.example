# Copy to .env and fill in values (local development)
# Never commit .env to git

# MongoDB — required
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/outreach_db
MONGO_URI=mongodb://localhost:27017

# Flask session encryption — required in production
FLASK_SECRET_KEY=change-this-to-a-long-random-string

# Public URL of your deployed web app — required for open/click tracking
# Local: http://127.0.0.1:5001
# Render: https://your-app-name.onrender.com
TRACKING_BASE_URL=http://127.0.0.1:5001

# Worker settings
ENABLE_INLINE_WORKER=0
WORKER_INTERVAL=60
WORKER_MAX_SENDS=50
